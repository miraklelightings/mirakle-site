{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#7A5C30}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.slot{background:#E3DED6;color:#6B6660;display:flex;align-items:flex-end;padding:18px;box-sizing:border-box;font-size:14px;line-height:1.5}\n.serif{}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:13px 16px 13px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660;width:38%}\n@media (max-width:760px){.wrap{padding:0 20px}}\n", "body": "\n\n\n\n\n\n<div style=\"font-family: 'Hanken Grotesk', system-ui, sans-serif; color: #1A1918; background: #F6F4F0; min-height: 100vh\">\n\n  <div style=\"background: #EDE9E3; border-bottom: 1px solid #DCD6CD\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 44px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-weight: 500; border-bottom: 2px solid #7A5C30\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">MIRAKLE home</a>\n    </div>\n  </div>\n\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\">\n      <a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 32px; width: auto; display: block\"></a>\n      <span style=\"font-size: 20px; font-style: normal\">Decorative</span>\n    </div>\n    <a class=\"cap\" href=\"/decorative/#selection\" style=\"text-decoration: none; border: 1px solid #1A1918; padding: 12px 18px\">Selection (0)</a>\n  </header>\n\n  <section style=\"padding: 0 4px\">\n    <div class=\"slot\" style=\"height: 560px; align-items: flex-start\">Full-bleed room: marble-and-brass pendants in a pair over a stone kitchen island. Visualisation</div>\n  </section>\n\n  <section class=\"wrap\" style=\"padding-top: 56px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-end; justify-content: space-between\">\n    <div style=\"display: flex; flex-direction: column; gap: 12px; max-width: 720px\">\n      <span style=\"font-size: 14px; color: #6B6660\"><a href=\"/decorative/\" style=\"color: #6B6660\">Decorative</a> / <a href=\"/decorative/#families\" style=\"color: #6B6660\">By material</a> / Marble</span>\n      <h1 style=\"margin: 0; font-size: 56px; line-height: 1; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Marble</h1>\n      <p style=\"margin: 0; font-size: 16px; line-height: 1.65; color: #6B6660\">Bulgari and Spanish marble with brass, copper, iron and glass. Six pendants in one family.</p>\n    </div>\n    <span style=\"font-size: 14px; color: #6B6660\">1-year warranty \u00b7 lamps as listed per piece</span>\n  </section>\n\n  <section class=\"wrap\" style=\"padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start\">\n    <div style=\"flex: 999 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px\">\n      \n        <button type=\"button\" aria-pressed=\"false\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid transparent\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1169</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">White</span>\n        </button>\n      \n        <button type=\"button\" aria-pressed=\"true\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid #1A1918\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1166</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">Brass</span>\n        </button>\n      \n        <button type=\"button\" aria-pressed=\"false\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid transparent\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1202</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">Copper, black</span>\n        </button>\n      \n        <button type=\"button\" aria-pressed=\"false\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid transparent\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1203</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">Copper, green</span>\n        </button>\n      \n        <button type=\"button\" aria-pressed=\"false\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid transparent\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1179</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">Black</span>\n        </button>\n      \n        <button type=\"button\" aria-pressed=\"false\" style=\"text-align: left; background: transparent; border: 0; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; border-bottom: 2px solid transparent\">\n          <span class=\"slot\" style=\"aspect-ratio: 3 / 4; width: 100%; display: flex\">Cut-out on warm ground</span>\n          <span style=\"font-size: 16px; letter-spacing: 0.08em; padding: 12px 0 2px; display: block\">HPHL1205</span>\n          <span style=\"font-size: 14px; color: #6B6660; display: block\">Brass</span>\n        </button>\n      \n    </div>\n    <aside aria-label=\"Selected piece\" style=\"flex: 1 1 360px; background: #F6F4F0; padding: 32px; display: flex; flex-direction: column; gap: 16px\">\n      <span class=\"cap\" style=\"color: #6B6660\">Selected</span>\n      <span style=\"font-size: 40px; line-height: 1; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">HPHL1166</span>\n      <div class=\"slot\" style=\"height: 200px; background: #F6F4F0; border: 1px solid #DCD6CD; justify-content: center; align-items: center\">Dimensioned line drawing, D120 \u00d7 H320 mm</div>\n      <table class=\"tbl\">\n        <tbody>\n          <tr><th scope=\"row\">Finish</th><td>Brass</td></tr>\n          <tr><th scope=\"row\">Material</th><td>Steel, Spanish marble, marble</td></tr>\n          <tr><th scope=\"row\">Size</th><td>D120 \u00d7 H320 mm</td></tr>\n          <tr><th scope=\"row\">Light source</th><td>G9 \u00d7 1</td></tr>\n        </tbody>\n      </table>\n      <button type=\"button\" style=\"padding: 16px; background: #1A1918; color: #F6F4F0; border: 0; font: inherit; letter-spacing: 0.18em; text-transform: uppercase; font-size: 12px; cursor: pointer\">Add to selection</button>\n      <a href=\"https://wa.me/919316888316\" class=\"cap\" style=\"text-decoration: none; text-align: center; padding: 8px\">WhatsApp Preksha Shah</a>\n      <span style=\"font-size: 14px; color: #6B6660\">Preksha Shah \u00b7 +91 93168 88316 \u00b7 luce@hrishalightings.com</span>\n    </aside>\n  </section>\n\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 72px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 28px\">\n      <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">The material, close up</h2>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 4px\">\n        <div class=\"slot\" style=\"height: 320px\">Detail: Bulgari marble grain under light</div>\n        <div class=\"slot\" style=\"height: 320px\">Detail: brass and marble joint</div>\n        <div class=\"slot\" style=\"height: 320px\">Detail: glass shade lit, copper fitting</div>\n      </div>\n    </div>\n  </section>\n</div>\n", "footer": true}