{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.slot{background:#E3DED6;color:#6B6660;display:flex;align-items:flex-end;padding:16px;box-sizing:border-box;font-size:14px;line-height:1.5}\n.chk{display:flex;gap:10px;align-items:center;font-size:14px;padding:6px 0}\n@media (max-width:760px){.wrap{padding:0 20px}}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n", "body": "\n\n\n\n\n\n<div style=\"font-family: 'Hanken Grotesk', system-ui, sans-serif; color: #1A1918; background: #F6F4F0; min-height: 100vh\">\n\n  <div style=\"background: #EDE9E3; border-bottom: 1px solid #DCD6CD\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 44px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-weight: 500; border-bottom: 2px solid #A8421F\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">MIRAKLE home</a>\n    </div>\n  </div>\n\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px; border-bottom: 1px solid #DCD6CD\">\n    <div style=\"display: flex; align-items: center; gap: 16px\">\n      <a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 32px; width: auto; display: block\"></a>\n      <span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical</span>\n    </div>\n    <nav aria-label=\"Architectural\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/architectural/elva-5/\" style=\"text-decoration: none\">Magnetic track</a>\n      <a class=\"cap\" href=\"#finder\" style=\"text-decoration: none\">Spotlights</a>\n      <a class=\"cap\" href=\"/architectural/linear/\" style=\"text-decoration: none\">Linear</a>\n      <a class=\"cap\" href=\"/architectural/drivers/\" style=\"text-decoration: none\">LED drivers</a>\n      <a class=\"cap\" href=\"/architectural/titan/\" style=\"text-decoration: none\">Configurator</a>\n      <a class=\"cap\" href=\"/contact/#architectural\" style=\"text-decoration: none; background: #1A1918; color: #F6F4F0; padding: 12px 20px\">Spec support</a>\n    </nav>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 48px; padding-top: 72px; padding-bottom: 72px; align-items: flex-end\">\n    <div style=\"flex: 1 1 480px; display: flex; flex-direction: column; gap: 24px\">\n      <span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical Lighting</span>\n      <h1 style=\"margin: 0; font-size: 56px; line-height: 1.04; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Light is the first material.</h1>\n      <p style=\"margin: 0; font-size: 20px; line-height: 1.6; color: #6B6660; max-width: 560px\">A 48V magnetic track system, nineteen COB series, four linear ranges and the LED drivers that run them \u2014 drawn to the same rules, so a project reads as one hand.</p>\n    </div>\n    <figure style=\"flex: 1 1 520px; margin: 0; display: flex; flex-direction: column; gap: 8px\"><div style=\"height: 440px; overflow: hidden; background: #DEDBD6\"><img class=\"ph\" src=\"/img/viz_titan.jpg\" alt=\"Recessed spotlights grazing a lime-plaster wall in a living room\"></div><figcaption style=\"font-size: 12px; color: #6B6660; letter-spacing: 0.06em; text-transform: uppercase\">Visualisation \u00b7 TITAN recessed, living room</figcaption></figure>\n  </section>\n\n  <!-- Range -->\n  <section id=\"range\" class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 4px; padding-bottom: 96px\">\n    <a href=\"/architectural/elva-5/\" style=\"text-decoration: none; background: #EDE9E3; padding: 28px; display: flex; flex-direction: column; gap: 12px; min-height: 260px\">\n      <span class=\"cap\" style=\"color: #6B6660\">01</span>\n      <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">ELVA 5</span>\n      <span style=\"font-size: 16px; line-height: 1.55; color: #6B6660\">An ultra-slim 48V magnetic track. Spots, grilles, a marble globe and a speaker click on by magnet.</span>\n      <span class=\"cap\" style=\"margin-top: auto\">9 modules \u2192</span>\n    </a>\n    <a href=\"#finder\" style=\"text-decoration: none; background: #EDE9E3; padding: 28px; display: flex; flex-direction: column; gap: 12px; min-height: 260px\">\n      <span class=\"cap\" style=\"color: #6B6660\">02</span>\n      <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">COB spotlights</span>\n      <span style=\"font-size: 16px; line-height: 1.55; color: #6B6660\">Recessed, surface and modular. Made to order, with the LED driver included.</span>\n      <span class=\"cap\" style=\"margin-top: auto\">19 series \u2192</span>\n    </a>\n    <a href=\"/architectural/linear/\" style=\"text-decoration: none; background: #EDE9E3; padding: 28px; display: flex; flex-direction: column; gap: 12px; min-height: 260px\">\n      <span class=\"cap\" style=\"color: #6B6660\">03</span>\n      <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Linear</span>\n      <span style=\"font-size: 16px; line-height: 1.55; color: #6B6660\">OPTIPRO LED strips, the CURVA 3D neon band, the ARCUS fa\u00e7ade grazer and SKYLIT for stretch ceilings.</span>\n      <span class=\"cap\" style=\"margin-top: auto\">4 ranges \u2192</span>\n    </a>\n    <a href=\"/architectural/drivers/\" style=\"text-decoration: none; background: #EDE9E3; padding: 28px; display: flex; flex-direction: column; gap: 12px; min-height: 260px\">\n      <span class=\"cap\" style=\"color: #6B6660\">04</span>\n      <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">LED drivers</span>\n      <span style=\"font-size: 16px; line-height: 1.55; color: #6B6660\">Constant-voltage drivers, 24V and 48V, indoor and IP67, rated for 100% load.</span>\n      <span class=\"cap\" style=\"margin-top: auto\">6 families \u2192</span>\n    </a>\n  </section>\n\n  <!-- In situ -->\n  <section class=\"wrap\" style=\"padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px\">\n      <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">In situ</h2>\n      <span style=\"font-size: 12px; color: #6B6660; letter-spacing: 0.06em; text-transform: uppercase\">Visualisations \u2014 not project photographs</span>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 520px), 1fr)); gap: 28px 20px\">\n      <figure style=\"margin: 0; display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"aspect-ratio: 3 / 2; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/viz_titan.jpg\" alt=\"TITAN \u2014 Wall-washing a plaster wall\"></div>\n        <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">TITAN</span>\n        <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Wall-washing a plaster wall \u00b7 Residence \u00b7 living room</span>\n      </figure>\n      <figure style=\"margin: 0; display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"aspect-ratio: 3 / 2; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/viz_orbis.jpg\" alt=\"ORBIS \u2014 Scallops on walnut panelling\"></div>\n        <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">ORBIS</span>\n        <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Scallops on walnut panelling \u00b7 Hotel \u00b7 guest corridor</span>\n      </figure>\n      <figure style=\"margin: 0; display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"aspect-ratio: 3 / 2; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/viz_hydro.jpg\" alt=\"HYDRO \u2014 Recessed over vanity and shower\"></div>\n        <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">HYDRO</span>\n        <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Recessed over vanity and shower \u00b7 Residence \u00b7 bathroom</span>\n      </figure>\n      <figure style=\"margin: 0; display: flex; flex-direction: column; gap: 10px\">\n        <div style=\"aspect-ratio: 3 / 2; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/viz_tide.jpg\" alt=\"TIDE \u2014 Surface cylinders over a long table\"></div>\n        <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">TIDE</span>\n        <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Surface cylinders over a long table \u00b7 Hospitality \u00b7 caf\u00e9</span>\n      </figure>\n    </div>\n  </section>\n\n  <!-- Finder -->\n  <section id=\"finder\" style=\"background: #F6F4F0; border-top: 1px solid #DCD6CD; border-bottom: 1px solid #DCD6CD\">\n    <div class=\"wrap\" style=\"padding-top: 72px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px\">\n        <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">COB spotlights</h2>\n        <span style=\"font-size: 14px; color: #6B6660\">19 of 19 series</span>\n      </div>\n      <div role=\"group\" aria-label=\"Mounting\" style=\"display: flex; gap: 8px; flex-wrap: wrap\">\n        \n          <button type=\"button\" aria-pressed=\"true\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #1A1918; background: #1A1918; color: #F6F4F0\">All</button>\n        \n          <button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #F6F4F0; color: #1A1918\">Recessed \u00b7 fixed</button>\n        \n          <button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #F6F4F0; color: #1A1918\">Recessed \u00b7 adjustable</button>\n        \n          <button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #F6F4F0; color: #1A1918\">Recessed \u00b7 linear</button>\n        \n          <button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #F6F4F0; color: #1A1918\">Surface</button>\n        \n          <button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #F6F4F0; color: #1A1918\">Modular</button>\n        \n      </div>\n      <div style=\"display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start\">\n        <aside aria-label=\"Filters\" style=\"flex: 1 1 220px; max-width: 260px; display: flex; flex-direction: column; gap: 28px\">\n          <fieldset style=\"border: 0; margin: 0; padding: 0\">\n            <legend class=\"cap\" style=\"padding: 0 0 8px; color: #6B6660\">CCT</legend>\n            <label class=\"chk\"><input type=\"checkbox\"> 3000K</label>\n            <label class=\"chk\"><input type=\"checkbox\"> 4000K</label>\n            <label class=\"chk\"><input type=\"checkbox\"> 5000K</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Tunable white 2700\u20136500K</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Dim-to-warm 1800\u20134000K</label>\n          </fieldset>\n          <fieldset style=\"border: 0; margin: 0; padding: 0\">\n            <legend class=\"cap\" style=\"padding: 0 0 8px; color: #6B6660\">Control</legend>\n            <label class=\"chk\"><input type=\"checkbox\"> On/off</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Phase-cut</label>\n            <label class=\"chk\"><input type=\"checkbox\"> DALI DT6</label>\n            <label class=\"chk\"><input type=\"checkbox\"> DALI DT8</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Bluetooth</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Casambi</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Zigbee</label>\n            <label class=\"chk\"><input type=\"checkbox\"> Matter</label>\n            <label class=\"chk\"><input type=\"checkbox\"> RF</label>\n          </fieldset>\n          <fieldset style=\"border: 0; margin: 0; padding: 0\">\n            <legend class=\"cap\" style=\"padding: 0 0 8px; color: #6B6660\">IP rating</legend>\n            <label class=\"chk\"><input type=\"checkbox\"> IP20</label>\n            <label class=\"chk\"><input type=\"checkbox\"> IP54</label>\n            <label class=\"chk\"><input type=\"checkbox\"> IP65</label>\n          </fieldset>\n          <span style=\"font-size: 12px; color: #6B6660; line-height: 1.5\">Filters read the same fields as the ordering code. Wattage, beam, CRI and UGR filters are added from the product data.</span>\n        </aside>\n        <div style=\"flex: 999 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 28px 20px\">\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/titan.jpg\" alt=\"TITAN\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">TITAN</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Controlled light. Quiet ceilings.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/SPY.jpg\" alt=\"SPY\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">SPY</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">A honeycomb in 46.5 mm.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/orbis.jpg\" alt=\"ORBIS\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">ORBIS</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Opens from the front. \u00d850 and up.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/UNO.jpg\" alt=\"UNO\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">UNO</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Small opening. Deep-set light.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/NANO.jpg\" alt=\"NANO\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">NANO</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Pinhole light from a 31 mm cut-out.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HYDRO.jpg\" alt=\"HYDRO\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">HYDRO</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Sealed for wet rooms.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/FUNNEL.jpg\" alt=\"FUNNEL\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">FUNNEL</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">24\u00b0 or 50\u00b0 from a 65 mm opening.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/AEGIS.jpg\" alt=\"AEGIS\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">AEGIS</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Deep set. Wall washed.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 fixed</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/ZOOM.jpg\" alt=\"ZOOM\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">ZOOM</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">See less, light more.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 adjustable</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/CIRCUS.jpg\" alt=\"CIRCUS\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">CIRCUS</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Precise light. Tilted to suit.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 adjustable</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/DART.jpg\" alt=\"DART\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">DART</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">One point of light.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 adjustable</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/METAL.jpg\" alt=\"METAL\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">METAL</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">A line of light in 27 mm.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 linear</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/VITA.jpg\" alt=\"VITA\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">VITA</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Narrow laser. Glare controlled.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Recessed \u00b7 linear</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/CIRCUS-SPOTBOY.jpg\" alt=\"CIRCUS SPOTBOY\"></div>\n              \n              <span style=\"font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase\">CIRCUS SPOTBOY</span>\n              <span style=\"font-size: 14px; color: #6B6660; line-height: 1.45\">Aimed light. Any ceiling.</span>\n              <span class=\"cap\" style=\"color: #6B6660; font-size: 12px\">Surface</span>\n            </a>\n          \n            <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 10px\">\n              <div style=\"aspect-ratio: 1 / 1; overflow: hi