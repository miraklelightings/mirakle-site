{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; border-bottom: 2px solid #B08A4E; color: #F6F4F0\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a><span class=\"cap\" style=\"color: #6B6660\">Decorative</span></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/decorative/pendants/\" style=\"text-decoration: none\">Pendant &amp; hanging</a>\n      <a class=\"cap\" href=\"/decorative/#types\" style=\"text-decoration: none\">Wall</a>\n      <a class=\"cap\" href=\"/decorative/#types\" style=\"text-decoration: none\">Ceiling</a>\n      <a class=\"cap\" href=\"/decorative/#types\" style=\"text-decoration: none\">Table &amp; floor</a>\n      <a class=\"cap\" href=\"/decorative/#families\" style=\"text-decoration: none\">Materials</a>\n      <a class=\"btn\" href=\"/decorative/#selection\">Selection</a>\n    </nav>\n  </header>\n  <div style=\"height: 3px; background: #B08A4E\"></div>\n  <div class=\"wrap\" style=\"padding-top: 24px; font-size: 14px; color: #6B6660\"><a href=\"/decorative/\" style=\"color: #6B6660\">Decorative</a> / Pendant &amp; hanging</div>\n  <section class=\"wrap\" style=\"padding-top: 32px; padding-bottom: 32px; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-end\">\n    <div style=\"display: flex; flex-direction: column; gap: 14px; max-width: 720px\">\n      <span class=\"cap\" style=\"color: #6B6660\">03 \u00b7 Decorative</span>\n      <h1 class=\"disp\">Pendant &amp; hanging</h1>\n      <p class=\"body\" style=\"margin: 0\">150 designs in metal, glass, marble, resin, fabric and paper. Each piece is named by its code; filter by material.</p>\n    </div>\n    <span class=\"small\">Showing 8 of 150 \u00b7 first designs of the range</span>\n  </section>\n  <section class=\"wrap\" style=\"padding-bottom: 24px\">\n    <div role=\"group\" aria-label=\"Material\" style=\"display: flex; gap: 8px; flex-wrap: wrap\">\n      <button type=\"button\" aria-pressed=\"true\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #1A1918; background: #1A1918; color: #F6F4F0\">All</button><button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #FFFFFF; color: #1A1918\">Metal</button><button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #FFFFFF; color: #1A1918\">Glass</button><button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #FFFFFF; color: #1A1918\">Marble</button><button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #FFFFFF; color: #1A1918\">Resin</button><button type=\"button\" aria-pressed=\"false\" style=\"padding: 12px 18px; font: inherit; font-size: 14px; cursor: pointer; border: 1px solid #DCD6CD; background: #FFFFFF; color: #1A1918\">Fabric</button>\n    </div>\n  </section>\n  <section class=\"wrap\" style=\"padding-bottom: 104px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 40px 24px\">\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1280.jpg\" alt=\"HPHL1280 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1280</span><span class=\"small\">Oatmeal ash</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Aircraft aluminium alloy, cold-rolled steel, optical acrylic</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D350 \u00d7 H160 \u00d7 H1800 mm</span><span>3000K, smart dimming, 40 W</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1275.jpg\" alt=\"HPHL1275 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1275</span><span class=\"small\">Wood grain</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Aircraft aluminium alloy, cold-rolled steel, optical acrylic</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D545 \u00d7 H150 \u00d7 H1500 mm</span><span>3000K, smart dimming, 26 W</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1249.jpg\" alt=\"HPHL1249 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1249</span><span class=\"small\">Smokey</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Iron, glass</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D260 \u00d7 H350 mm</span><span>LED</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1252.jpg\" alt=\"HPHL1252_GD pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1252_GD</span><span class=\"small\">Brass</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Aluminium, crystal</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>\u03a6125 mm</span><span>LED</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1166.jpg\" alt=\"HPHL1166 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1166</span><span class=\"small\">Brass</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Steel, Spanish marble, marble</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D120 \u00d7 H320 mm</span><span>G9 \u00d7 1</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1202.jpg\" alt=\"HPHL1202 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1202</span><span class=\"small\">Copper, black</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Marble, glass</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D100 \u00d7 H190 mm</span><span>G9 \u00d7 1</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1206.jpg\" alt=\"HPHL1206 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1206</span><span class=\"small\">Outside gold, inside white</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Resin</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>D200 \u00d7 H310 mm</span><span>LED</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n      <article style=\"display: flex; flex-direction: column; gap: 12px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/HPHL1162.jpg\" alt=\"HPHL1162 pendant, visualisation\"></div>\n        <div style=\"display: flex; justify-content: space-between; align-items: baseline; gap: 12px\"><span class=\"h2\" style=\"font-size: 20px; letter-spacing: 0.06em\">HPHL1162</span><span class=\"small\">Gray</span></div>\n        <span class=\"small\" style=\"color: #1A1918\">Fabric, ceramic clay</span>\n        <div style=\"display: flex; gap: 16px; flex-wrap: wrap\" class=\"small\"><span>\u03a6400 \u00d7 H280 mm</span><span>E27 \u00d7 1</span></div>\n        <button type=\"button\" class=\"cap\" style=\"align-self: flex-start; background: transparent; border: 1px solid #1A1918; padding: 12px 16px; font-family: inherit; cursor: pointer; color: #1A1918\">Add to selection</button>\n      </article>\n    \n  </section>\n  <section style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 56px; padding-bottom: 56px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between\">\n      <span style=\"font-size: 20px\">Your selection: 0 pieces</span>\n      <div style=\"display: flex; gap: 12px; flex-wrap: wrap\"><a class=\"btn\" href=\"/decorative/#selection\" style=\"background: #F6F4F0; color: #1A1918\">Send for a quote</a><a class=\"btn\" href=\"https://wa.me/919316888316\" style=\"background: transparent; border: 1px solid #F6F4F0\">WhatsApp Preksha Shah</a></div>\n    </div>\n  </section>\n  <footer style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #F6F4F0; text-decoration: none\">Architectural &amp; Technical</a>\n        <a href=\"/quiklit/\" style=\"color: #F6F4F0; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #F6F4F0; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"/about/\" style=\"color: #F6F4F0; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #F6F4F0; text-decoration: none\">Downloads</a>\n        <a href=\"/contact/\" style=\"color: #F6F4F0; text-decoration: none\">Contact \u00b7 Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #F6F4F0; text-decoration: none\">Instagram</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #F6F4F0; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. \u00a9 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}