{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.slot{background:#E3DED6;color:#6B6660;display:flex;align-items:flex-end;padding:16px;box-sizing:border-box;font-size:14px;line-height:1.5}\n.line{height:3px;background:linear-gradient(90deg,#F43F5E,#A855F7)}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n@media (max-width:760px){.wrap{padding:0 20px}}\n", "body": "\n\n\n\n\n\n<div style=\"font-family: 'Hanken Grotesk', system-ui, sans-serif; color: #1A1918; background: #F6F4F0; min-height: 100vh\">\n\n  <div style=\"background: #EDE9E3; border-bottom: 1px solid #DCD6CD;\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 44px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-weight: 500; color: #1A1918; border-bottom: 2px solid #A855F7\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">MIRAKLE home</a>\n    </div>\n  </div>\n\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 20px; padding-bottom: 20px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/quiklit/\" aria-label=\"QuikLit home\" style=\"display: flex; align-items: center; gap: 12px; text-decoration: none\"><img src=\"/img/quiklit-black.png\" alt=\"QuikLit\" style=\"height: 24px; width: auto; display: block\"></a><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex; align-items: center; gap: 8px; text-decoration: none; padding-left: 16px; border-left: 1px solid #DCD6CD\"><span style=\"font-size: 12px; color: #6B6660\">by</span><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 20px; width: auto; display: block\"></a></div>\n    <nav aria-label=\"QuikLit\" style=\"display: flex; gap: 24px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/quiklit/#profiles\" style=\"text-decoration: none\">Profiles</a>\n      <a class=\"cap\" href=\"/quiklit/#families\" style=\"text-decoration: none\">QuikMag</a>\n      <a class=\"cap\" href=\"/quiklit/#install\" style=\"text-decoration: none\">Install</a>\n      <a class=\"cap\" href=\"/quiklit/boq/\" style=\"text-decoration: none; background: #1A1918; color: #F6F4F0; padding: 12px 18px\">BOQ calculator</a>\n    </nav>\n  </header>\n  <div class=\"line\"></div>\n\n  <div class=\"wrap\" style=\"padding-top: 20px; font-size: 14px; color: #6B6660\"><a href=\"/quiklit/\" style=\"color: #6B6660\">QuikLit</a> / <a href=\"/quiklit/#profiles\" style=\"color: #6B6660\">Solderless profiles</a> / QUIKLIT-1707</div>\n\n  <section class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 48px; padding-top: 28px; padding-bottom: 64px\">\n    <div style=\"flex: 1 1 600px; height: 520px; overflow: hidden; background: #1A1918\"><img src=\"/img/ql_1707_lit.jpg\" alt=\"QUIKLIT-1707 lit\" style=\"width: 100%; height: 100%; object-fit: cover; display: block\"></div>\n    <div style=\"flex: 1 1 380px; display: flex; flex-direction: column; gap: 20px\">\n      <div style=\"display: flex; gap: 10px; align-items: center\"><span class=\"cap\" style=\"color: #6B6660\">Solderless LED profile</span><span class=\"cap\" style=\"background: #1A1918; color: #F6F4F0; padding: 4px 8px; font-size: 12px\">New</span></div>\n      <h1 style=\"margin: 0; font-size: 56px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">QUIKLIT-1707</h1>\n      <p style=\"margin: 0; font-size: 20px; line-height: 1.5; color: #6B6660\">Solder-free 17 \u00d7 7 mm recessed profile with an opal cover for a dot-free line of light.</p>\n      <div style=\"display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #DCD6CD; border-bottom: 1px solid #DCD6CD\">\n        <div style=\"padding: 16px 0; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 20px; font-weight: 500\">16 W/m</span><span style=\"font-size: 12px; color: #6B6660\">Power</span></div>\n        <div style=\"padding: 16px 0; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 20px; font-weight: 500\">17 \u00d7 7 mm</span><span style=\"font-size: 12px; color: #6B6660\">Groove</span></div>\n        <div style=\"padding: 16px 0; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 20px; font-weight: 500\">5 years</span><span style=\"font-size: 12px; color: #6B6660\">Warranty on the light</span></div>\n      </div>\n      <div style=\"height: 240px; overflow: hidden; padding: 12px; background: #FFFFFF\"><img src=\"/img/ql_sec_1707.jpg\" alt=\"QUIKLIT-1707 section, groove 17 \u00d7 7 mm\" style=\"width: 100%; height: 100%; object-fit: contain; display: block\"></div>\n    </div>\n  </section>\n\n  <section class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 48px; padding-bottom: 72px\">\n    <div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 16px\">\n      <h2 class=\"cap\" style=\"margin: 0; font-size: 14px; font-weight: 500\">Specification</h2>\n      <table class=\"tbl\">\n        <tbody>\n          <tr><th scope=\"row\">Size</th><td>17 \u00d7 7 mm</td></tr>\n          <tr><th scope=\"row\">Power</th><td>16 W/m</td></tr>\n          <tr><th scope=\"row\">CCT</th><td>3000K \u00b7 4000K</td></tr>\n          <tr><th scope=\"row\">CRI</th><td>90</td></tr>\n          <tr><th scope=\"row\">Voltage</th><td>24V DC</td></tr>\n          <tr><th scope=\"row\">Groove</th><td>W 17 \u00b7 H 7 mm</td></tr>\n          <tr><th scope=\"row\">Cover</th><td>Opal</td></tr>\n          <tr><th scope=\"row\">LED</th><td>Double-PCB SMD</td></tr>\n          <tr><th scope=\"row\">Mounting</th><td>Recessed</td></tr>\n          <tr><th scope=\"row\">Body colour</th><td>Roman grey</td></tr>\n          <tr><th scope=\"row\">Warranty</th><td>5 years on the light. Accessory sets, connectors and wires are not covered.</td></tr>\n        </tbody>\n      </table>\n    </div>\n    <div style=\"flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px\">\n      <h2 class=\"cap\" style=\"margin: 0; font-size: 14px; font-weight: 500\">Order codes</h2>\n      <div style=\"display: flex; flex-direction: column; border-top: 1px solid #1A1918\">\n        <div style=\"padding: 16px 0; border-bottom: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-weight: 500\">QUIKLIT-1707-3K \u00b7 QUIKLIT-1707-4K</span><span style=\"font-size: 14px; color: #6B6660\">Aluminium profile with opal diffuser, double-PCB SMD LED, 24V DC, CRI 90</span></div>\n        <div style=\"padding: 16px 0; border-bottom: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-weight: 500\">QUIKLIT-1707-ACC</span><span style=\"font-size: 14px; color: #6B6660\">1 wired end cap (1800 mm wire), 1 end cap, 2 back clips \u00b7 white / transparent</span></div>\n        <div style=\"padding: 16px 0; border-bottom: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-weight: 500\">QUIKLIT-1707-CORNER CONNECTOR</span><span style=\"font-size: 14px; color: #6B6660\">Joins two 1707 profiles at a corner \u00b7 white / transparent</span></div>\n        <div style=\"padding: 16px 0; border-bottom: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 4px\"><span style=\"font-weight: 500\">QUIKLIT-1707-STRAIGHT JOINTER</span><span style=\"font-size: 14px; color: #6B6660\">Joins two 1707 profiles in a straight line \u00b7 white / transparent</span></div>\n      </div>\n    </div>\n  </section>\n\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 72px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 28px\">\n      <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Completes the system</h2>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px\">\n        <a href=\"/quiklit/#families\" style=\"text-decoration: none; background: #F6F4F0; padding: 24px; display: flex; flex-direction: column; gap: 8px\"><span style=\"font-weight: 500\">QuikPower 24V</span><span style=\"font-size: 14px; color: #6B6660\">60 \u00b7 100 \u00b7 150 W and Global 100 W, sized to the total load</span></a>\n        <a href=\"/quiklit/#families\" style=\"text-decoration: none; background: #F6F4F0; padding: 24px; display: flex; flex-direction: column; gap: 8px\"><span style=\"font-weight: 500\">QuikSens</span><span style=\"font-size: 14px; color: #6B6660\">Door, presence, hand sweep or touch</span></a>\n        <a href=\"/quiklit/#families\" style=\"text-decoration: none; background: #F6F4F0; padding: 24px; display: flex; flex-direction: column; gap: 8px\"><span style=\"font-weight: 500\">Wiring</span><span style=\"font-size: 14px; color: #6B6660\">Splitter and extension wires</span></a>\n      </div>\n      <span style=\"font-size: 14px; color: #6B6660\">Every QuikLit profile runs on 24V DC and connects with plug-and-play wiring and sockets.</span>\n    </div>\n  </section>\n\n  <section class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 48px; padding-top: 72px; padding-bottom: 96px\">\n    <div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 16px\">\n      <h2 class=\"cap\" style=\"margin: 0; font-size: 14px; font-weight: 500\">Fitting it</h2>\n      <div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px\"><div style=\"background: #FFFFFF; padding: 10px; height: 140px\"><img src=\"/img/ql_step1.jpg\" alt=\"Step 1\" style=\"width: 100%; height: 100%; object-fit: contain; display: block\"></div><div style=\"background: #FFFFFF; padding: 10px; height: 140px\"><img src=\"/img/ql_step2.jpg\" alt=\"Step 2\" style=\"width: 100%; height: 100%; object-fit: contain; display: block\"></div><div style=\"background: #FFFFFF; padding: 10px; height: 140px\"><img src=\"/img/ql_step3.jpg\" alt=\"Step 3\" style=\"width: 100%; height: 100%; object-fit: contain; display: block\"></div><div style=\"background: #FFFFFF; padding: 10px; height: 140px\"><img src=\"/img/ql_step4.jpg\" alt=\"Step 4\" style=\"width: 100%; height: 100%; object-fit: contain; display: block\"></div></div>\n      <span style=\"font-size: 14px; color: #6B6660; line-height: 1.6\">Cut at the pads between groups so every LED keeps its resistor. Cutting through a chip or a resistor stops that LED.</span>\n      <a href=\"/downloads/\" class=\"cap\" style=\"text-decoration: none\">Request datasheet \u2192</a>\n    </div>\n    <div id=\"sample\" style=\"flex: 1 1 380px; background: #1A1918; color: #F6F4F0; padding: 32px; display: flex; flex-direction: column; gap: 14px\">\n      <span class=\"cap\" style=\"color: #A39D94\">For furniture makers</span>\n      <span style=\"font-size: 28px; line-height: 1.2; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Try QUIKLIT-1707 in your factory.</span>\n      <span style=\"font-size: 16px; color: #A39D94; line-height: 1.5\">Ask for the profiles sample bag (QUIKLITFURSAMBAG). The QuikLit team calls back within 24 hours.</span>\n      <span style=\"font-size: 14px; color: #F6F4F0\">Awadhesh Pal \u00b7 +91 92279 96634 \u00b7 quiklit@hrishalightings.com</span>\n      <a href=\"/quiklit/#enquire\" class=\"cap\" style=\"text-decoration: none; background: #F6F4F0; color: #1A1918; padding: 14px 18px; align-self: flex-start\">Request a sample bag</a>\n    </div>\n  </section>\n</div>\n", "footer": true}