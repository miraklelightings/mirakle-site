{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#7A5C30}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.slot{background:#E3DED6;color:#6B6660;display:flex;align-items:flex-end;padding:18px;box-sizing:border-box;font-size:14px;line-height:1.5}\n.serif{}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select{padding:14px;border:1px solid #A39D94;background:#F6F4F0;font:inherit;color:#1A1918}\n@media (max-width:760px){.wrap{padding:0 20px}}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n", "body": "\n\n\n\n\n\n<div style=\"font-family: 'Hanken Grotesk', system-ui, sans-serif; color: #1A1918; background: #F6F4F0; min-height: 100vh\">\n\n  <div style=\"background: #EDE9E3; border-bottom: 1px solid #DCD6CD\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 44px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-weight: 500; border-bottom: 2px solid #7A5C30\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/\" style=\"text-decoration: none; padding: 12px 0; color: #6B6660\">MIRAKLE home</a>\n    </div>\n  </div>\n\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\">\n      <a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 32px; width: auto; display: block\"></a>\n      <span style=\"font-size: 20px; font-style: normal\">Decorative</span>\n    </div>\n    <nav aria-label=\"Decorative\" style=\"display: flex; gap: 24px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/decorative/pendants/\" style=\"text-decoration: none\">Pendant &amp; hanging</a>\n      <a class=\"cap\" href=\"#types\" style=\"text-decoration: none\">Wall</a>\n      <a class=\"cap\" href=\"#types\" style=\"text-decoration: none\">Ceiling</a>\n      <a class=\"cap\" href=\"#types\" style=\"text-decoration: none\">Table &amp; floor</a>\n      <a class=\"cap\" href=\"#families\" style=\"text-decoration: none\">Materials</a>\n      <a class=\"cap\" href=\"#selection\" style=\"text-decoration: none; border: 1px solid #1A1918; padding: 12px 18px\">Selection (0)</a>\n    </nav>\n  </header>\n\n  <!-- Hero -->\n  <section style=\"position: relative; padding: 0 4px\">\n    <div style=\"height: 720px; align-items: flex-start; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_dining.jpg\" alt=\"A silk pendant over a dining table, visualisation\"></div>\n    <div class=\"wrap\" style=\"position: relative; margin-top: -260px; padding-bottom: 40px\">\n      <div style=\"background: #F6F4F0; max-width: 620px; padding: 40px 44px; display: flex; flex-direction: column; gap: 16px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Decorative lighting</span>\n        <h1 style=\"margin: 0; font-size: 56px; line-height: 1.02; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Pieces that hold a room.</h1>\n        <p style=\"margin: 0; font-size: 16px; line-height: 1.65; color: #6B6660\">Pendants, wall, ceiling, table and floor lights in marble, brass, silk, glass and resin, chosen for homes, hotels and restaurants.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Types -->\n  <section id=\"types\" class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px\">\n    <h2 class=\"cap\" style=\"margin: 0; font-weight: 500; font-size: 14px\">By type</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px\">\n      <a href=\"/decorative/pendants/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 12px\"><div style=\"aspect-ratio: 3 / 4; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_linear.jpg\" alt=\"Linear pendant bars with stone blocks\"></div><span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Pendant &amp; hanging</span><span style=\"font-size: 14px; color: #6B6660\">150 designs</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 12px\"><div style=\"aspect-ratio: 3 / 4; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_wall.jpg\" alt=\"Two round wall lights glowing on a concrete wall\"></div><span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Wall</span><span style=\"font-size: 14px; color: #6B6660\">30 designs</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 12px\"><div class=\"slot\" style=\"aspect-ratio: 3 / 4\">Ceiling light cut-out</div><span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Ceiling</span><span style=\"font-size: 14px; color: #6B6660\">14 designs</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 12px\"><div style=\"aspect-ratio: 3 / 4; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_table.jpg\" alt=\"A table lamp with a timber base on a console\"></div><span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Table &amp; floor</span><span style=\"font-size: 14px; color: #6B6660\">20 designs</span></a>\n    </div>\n  </section>\n\n  <!-- Families -->\n  <section id=\"families\" style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 40px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px\">\n        <h2 style=\"margin: 0; font-size: 56px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">By material</h2>\n        <span style=\"font-size: 14px; color: #A39D94\">Codes stay as product names; families group them</span>\n      </div>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px\">\n        \n          <a href=\"#families\" style=\"text-decoration: none; color: #F6F4F0; display: flex; flex-direction: column; gap: 12px\">\n            <div class=\"slot\" style=\"aspect-ratio: 4 / 5; background: #2E2C2A; color: #A39D94\">Marble and brass pendants, cut-outs</div>\n            <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Marble</span>\n            <span style=\"font-size: 14px; color: #A39D94; line-height: 1.5\">HPHL1169 \u00b7 HPHL1166 \u00b7 HPHL1202 \u00b7 HPHL1203 \u00b7 HPHL1179 \u00b7 HPHL1205</span>\n          </a>\n        \n          <a href=\"#families\" style=\"text-decoration: none; color: #F6F4F0; display: flex; flex-direction: column; gap: 12px\">\n            <div class=\"slot\" style=\"aspect-ratio: 4 / 5; background: #2E2C2A; color: #A39D94\">Silk spheres, 300 to 800 mm</div>\n            <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Mulberry silk</span>\n            <span style=\"font-size: 14px; color: #A39D94; line-height: 1.5\">HPHL1157 \u00b7 HPHL1158 \u00b7 HPHL1159 \u00b7 HPHL1231</span>\n          </a>\n        \n          <a href=\"#families\" style=\"text-decoration: none; color: #F6F4F0; display: flex; flex-direction: column; gap: 12px\">\n            <div class=\"slot\" style=\"aspect-ratio: 4 / 5; background: #2E2C2A; color: #A39D94\">Glass globes, smoky and amber</div>\n            <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Smoked &amp; amber glass</span>\n            <span style=\"font-size: 14px; color: #A39D94; line-height: 1.5\">HPHL1256 \u00b7 HPHL1257 \u00b7 HPHL1258 \u00b7 HPHL1259</span>\n          </a>\n        \n          <a href=\"#families\" style=\"text-decoration: none; color: #F6F4F0; display: flex; flex-direction: column; gap: 12px\">\n            <div class=\"slot\" style=\"aspect-ratio: 4 / 5; background: #2E2C2A; color: #A39D94\">Resin shades, natural finish</div>\n            <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Organic resin</span>\n            <span style=\"font-size: 14px; color: #A39D94; line-height: 1.5\">HPHL1155 \u00b7 HPHL1154 \u00b7 HPHL1156</span>\n          </a>\n        \n          <a href=\"#families\" style=\"text-decoration: none; color: #F6F4F0; display: flex; flex-direction: column; gap: 12px\">\n            <div class=\"slot\" style=\"aspect-ratio: 4 / 5; background: #2E2C2A; color: #A39D94\">Paper discs, 750 and 1000 mm</div>\n            <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Paper</span>\n            <span style=\"font-size: 14px; color: #A39D94; line-height: 1.5\">HPHL1160 \u00b7 HPHL1161</span>\n          </a>\n        \n      </div>\n    </div>\n  </section>\n\n  <!-- Rooms -->\n  <section class=\"wrap\" style=\"padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px\">\n    <h2 class=\"cap\" style=\"margin: 0; font-weight: 500; font-size: 14px\">By room</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4px\">\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column\"><div class=\"slot\" style=\"height: 360px\">Living room. Visualisation</div><span style=\"font-size: 28px; padding: 16px 0; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Living</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column\"><div style=\"height: 360px; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_kitchen.jpg\" alt=\"Brass pendants over a kitchen island, visualisation\"></div><span style=\"font-size: 28px; padding: 16px 0; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Dining</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column\"><div class=\"slot\" style=\"height: 360px\">Bedroom. Visualisation</div><span style=\"font-size: 28px; padding: 16px 0; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Bedroom</span></a>\n      <a href=\"#families\" style=\"text-decoration: none; display: flex; flex-direction: column\"><div style=\"height: 360px; overflow: hidden; padding: 0; background: #DEDBD6\"><img class=\"ph\" src=\"/img/deco_chandelier.jpg\" alt=\"A black chandelier over a round table, visualisation\"></div><span style=\"font-size: 28px; padding: 16px 0; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Hospitality</span></a>\n    </div>\n  </section>\n\n  <!-- Selection enquiry -->\n  <section id=\"selection\" style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 88px; padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start\">\n      <div style=\"flex: 1 1 360px; display: flex; flex-direction: column; gap: 16px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Your selection</span>\n        <h2 style=\"margin: 0; font-size: 40px; line-height: 1.08; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Save pieces as you browse. Send the list for a quote.</h2>\n        <p style=\"margin: 0; font-size: 16px; line-height: 1.6; color: #6B6660\">Or visit the showroom at Maruti Crystal, Bodakdev, Ahmedabad. 1-year warranty on decorative lighting.</p>\n        <span style=\"font-size: 14px\">Preksha Shah \u00b7 +91 93168 88316 \u00b7 luce@hrishalightings.com</span>\n        <span style=\"font-size: 14px; color: #6B6660\">Showroom open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <form aria-label=\"Decorative quote request\" style=\"flex: 1 1 460px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px\">\n        <label class=\"fld\">Your name<input type=\"text\"></label>\n        <label class=\"fld\">Mobile<input type=\"tel\"></label>\n        <label class=\"fld\">I am<select><option>Interior designer</option><option>Architect</option><option>Homeowner</option><option>Hotel or restaurant</option></select></label>\n        <label class=\"fld\">City<input type=\"text\"></label>\n        <label class=\"fld\">Project<select><option>Residential</option><option>Hospitality</option></select></label>\n        <label class=\"fld\">When<select><option>Within a month</option><option>1\u20133 months</option><option>Later</option></select></label>\n        <div style=\"grid-column: 1 / -1; font-size: 14px; color: #6B6660; border-top: 1px solid #A39D94; padding-top: 12px\">Selection attached automatically: 0 pieces</div>\n        <button type=\"button\" style=\"grid-column: 1 / -1; padding: 16px; background: #1A1918; color: #F6F4F0; border: 0; font: inherit; letter-spacing: 0.18em; text-transform: uppercase; font-size: 12px; cursor: pointer\">Send to the Decorative team</button>\n      </form>\n    </div>\n  </section>\n</div>\n", "footer": true}