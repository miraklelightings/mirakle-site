{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Archivo',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; border-bottom: 2px solid #1A1918; color: #F6F4F0\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom · Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a><span class=\"cap\" style=\"color: #6B6660\">Architectural</span></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/architectural/elva-5/\" style=\"text-decoration: none\">Magnetic track</a>\n      <a class=\"cap\" href=\"/architectural/#spotlights\" style=\"text-decoration: none\">Spotlights</a>\n      <a class=\"cap\" href=\"/architectural/linear/\" style=\"text-decoration: none\">Linear</a>\n      <a class=\"cap\" href=\"/architectural/drivers/\" style=\"text-decoration: none\">LED drivers</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"btn\" href=\"/contact/#architectural\">Spec support</a>\n    </nav>\n  </header>\n  <div style=\"height: 3px; background: #1A1918\"></div>\n  <div class=\"wrap\" style=\"padding-top: 24px; font-size: 14px; color: #6B6660\"><a href=\"/architectural/\" style=\"color: #6B6660\">Architectural</a> / Linear</div>\n  <section style=\"position: relative; margin-top: 24px\">\n    <div style=\"height: 640px; overflow: hidden; background: #1A1918\"><img class=\"ph\" src=\"/img/facade.jpg\" alt=\"A CURVA line tracing the edge of a building at dusk, visualisation\"></div>\n    <div class=\"wrap\" style=\"position: relative; margin-top: -220px; padding-bottom: 24px\">\n      <div style=\"background: #F6F4F0; max-width: 640px; padding: 40px 44px; display: flex; flex-direction: column; gap: 16px\">\n        <span class=\"cap\" style=\"color: #6B6660\">03 · Linear</span>\n        <h1 class=\"disp\">Lines of light</h1>\n        <p class=\"body\" style=\"margin: 0\">For coves, façades and ceilings. Four ranges of linear light, indoor and outdoor.</p>\n      </div>\n    </div>\n  </section>\n  <section class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 1px solid #DCD6CD; border-bottom: 1px solid #DCD6CD\"><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">4 ranges</span><span class=\"small\">Linear light</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">CRI 90+</span><span class=\"small\">Every range</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">24 · 48 V</span><span class=\"small\">Constant voltage</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">IP20 · IP67</span><span class=\"small\">Indoor and outdoor</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">5 · 2 years</span><span class=\"small\">Warranty, indoor · outdoor</span></div></section>\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 104px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3px\">\n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 14px\">\n        <span class=\"cap\" style=\"color: #6B6660\">LED strips</span>\n        <span class=\"h2\">OPTIPRO</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">Ten LED strips on one standard, for coves, furniture and façades.</span>\n        <ul style=\"list-style: none; margin: 8px 0 0; padding: 0; font-size: 14px; color: #6B6660\"><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">5, 8 and 10 mm PCB</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Epistar LEDs · CRI 90+</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">3000K, 4000K or tunable</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Eight IP20 strips for interiors, two IP67 for outdoors</li></ul>\n        <span class=\"small\" style=\"letter-spacing: 0.06em\">MUSE · MESH · HYPE · MOTION · HAZE · HYPER · MINT · MELO · HEXA · MARINOFLEX</span>\n        <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none; margin-top: auto; padding-top: 12px\">Request OPTIPRO datasheet →</a>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 14px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Neon</span>\n        <span class=\"h2\">CURVA</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">A 3D neon band that bends top and side.</span>\n        <ul style=\"list-style: none; margin: 8px 0 0; padding: 0; font-size: 14px; color: #6B6660\"><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">CURVA 3D 12</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Cut, cap, fix, connect</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Lines that turn corners</li></ul>\n        \n        <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none; margin-top: auto; padding-top: 12px\">Request CURVA datasheet →</a>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 14px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Grazer</span>\n        <span class=\"h2\">ARCUS</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">A grazer for façades and outdoor architecture.</span>\n        <ul style=\"list-style: none; margin: 8px 0 0; padding: 0; font-size: 14px; color: #6B6660\"><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">ARCUS 16</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Set, cut, fix, connect</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Façades, walls, columns</li></ul>\n        \n        <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none; margin-top: auto; padding-top: 12px\">Request ARCUS datasheet →</a>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 14px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Stretch ceiling</span>\n        <span class=\"h2\">SKYLIT</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">LED modules for backlit stretch ceilings and light boxes.</span>\n        <ul style=\"list-style: none; margin: 8px 0 0; padding: 0; font-size: 14px; color: #6B6660\"><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">170° lenses</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Three fixed whites and a tunable</li><li style=\"padding: 10px 0; border-top: 1px solid #DCD6CD\">Four versions</li></ul>\n        \n        <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none; margin-top: auto; padding-top: 12px\">Request SKYLIT datasheet →</a>\n      </div>\n    </div>\n  </section>\n  <footer style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101–103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am – 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #F6F4F0; text-decoration: none\">Architectural</a>\n        <a href=\"/quiklit/\" style=\"color: #F6F4F0; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #F6F4F0; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"/about/\" style=\"color: #F6F4F0; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #F6F4F0; text-decoration: none\">Downloads</a>\n        <a href=\"/contact/\" style=\"color: #F6F4F0; text-decoration: none\">Contact · Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #F6F4F0; text-decoration: none\">Instagram · @hrisha_lightings</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #F6F4F0; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. © 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}