{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; border-bottom: 2px solid #A8421F; color: #F6F4F0\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a><span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical</span></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/architectural/elva-5/\" style=\"text-decoration: none\">Magnetic track</a>\n      <a class=\"cap\" href=\"/architectural/#spotlights\" style=\"text-decoration: none\">Spotlights</a>\n      <a class=\"cap\" href=\"/architectural/linear/\" style=\"text-decoration: none\">Linear</a>\n      <a class=\"cap\" href=\"/architectural/drivers/\" style=\"text-decoration: none\">LED drivers</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"btn\" href=\"/contact/#architectural\">Spec support</a>\n    </nav>\n  </header>\n  <div style=\"height: 3px; background: #A8421F\"></div>\n  <div class=\"wrap\" style=\"padding-top: 24px; font-size: 14px; color: #6B6660\"><a href=\"/architectural/\" style=\"color: #6B6660\">Architectural</a> / Magnetic track / ELVA 5</div>\n  <section class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 56px; padding-top: 40px; padding-bottom: 72px; align-items: center\">\n    <div style=\"flex: 1 1 440px; display: flex; flex-direction: column; gap: 22px\">\n      <span class=\"cap\" style=\"color: #6B6660\">01 \u00b7 Magnetic track</span>\n      <h1 class=\"disp\">ELVA 5</h1>\n      <span style=\"font-size: 20px\">Ultra-slim magnetic lighting system.</span>\n      <p class=\"body\" style=\"margin: 0; max-width: 520px\">The light modules sit inside a 48 V track with a 5 mm opening in the ceiling. Bars, spots, a marble globe and a speaker click on by magnet and move by hand. Two profiles, two finishes and three control systems cover residential, hospitality and retail work.</p>\n      <div style=\"display: flex; gap: 12px; flex-wrap: wrap\"><a class=\"btn\" href=\"/contact/#architectural\">Plan a run with us</a><a class=\"btn\" href=\"/downloads/\" style=\"background: transparent; color: #1A1918; border: 1px solid #1A1918\">Request ELVA 5 datasheet</a></div>\n    </div>\n    <figure style=\"flex: 1 1 620px; margin: 0; display: flex; flex-direction: column; gap: 10px\">\n      <div style=\"height: 520px; overflow: hidden; background: #E3DED6\"><img class=\"ph\" src=\"/img/elva_room.jpg\" alt=\"Living room with an ELVA 5 trimless run, grille bars, fixed spots and three marble globes\"></div>\n      <figcaption class=\"small\">Visualisation \u00b7 living room \u00b7 grille bars, fixed spots and three globes on one trimless run</figcaption>\n    </figure>\n  </section>\n  <section class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 1px solid #DCD6CD; border-bottom: 1px solid #DCD6CD\"><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">48 V DC</span><span class=\"small\">Magnetic track</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">5 mm</span><span class=\"small\">Opening in the ceiling</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">CRI 90+</span><span class=\"small\">Every fitting</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">L90 \u00b7 50,000 h</span><span class=\"small\">Lifetime</span></div><div style=\"padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px\"><span style=\"font-size: 20px\">5 years</span><span class=\"small\">Warranty \u00b7 fittings</span></div></section>\n  <section class=\"wrap\" style=\"padding-top: 96px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 32px\">\n    <h2 class=\"h1\">Two tracks</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3px\">\n      <div style=\"background: #EDE9E3; padding: 36px; display: flex; flex-direction: column; gap: 10px\"><span class=\"h2\">Surface track</span><span class=\"small\" style=\"color: #1A1918\">Fixed below the ceiling, or hung on the suspension kit.</span><span class=\"small\">14 \u00d7 26 mm section \u00b7 1, 2 and 3 m lengths</span></div>\n      <div style=\"background: #EDE9E3; padding: 36px; display: flex; flex-direction: column; gap: 10px\"><span class=\"h2\">Trimless track</span><span class=\"small\" style=\"color: #1A1918\">Set into the ceiling and plastered over its 56 mm wings.</span><span class=\"small\">56 \u00d7 28 mm \u00b7 2 and 3 m lengths</span></div>\n    </div>\n  </section>\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px\"><h2 class=\"h1\">Nine modules, one line</h2><span class=\"small\">Two sit inside the track; seven click onto it</span></div>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 3px\">\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">In the track</span>\n        <span class=\"h2\">LINEAR</span>\n        <span class=\"small\" style=\"color: #1A1918\">No fitting, just the line.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>10 W \u00b7 15 W</span><span>180\u00b0 \u00b7 opal</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">In the track</span>\n        <span class=\"h2\">GRILLE SPOT</span>\n        <span class=\"small\" style=\"color: #1A1918\">Accent light from a line that stays flush with the ceiling.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>10 W \u00b7 15 W</span><span>30\u00b0</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">GRILLE</span>\n        <span class=\"small\" style=\"color: #1A1918\">Directional light with almost no visible body.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>15 W</span><span>30\u00b0</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">GRILLE TILT</span>\n        <span class=\"small\" style=\"color: #1A1918\">To angle light onto walls, shelves and art.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>10 W</span><span>30\u00b0 \u00b7 tilting head</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">FIXED SPOT</span>\n        <span class=\"small\" style=\"color: #1A1918\">The smallest spot in the range.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>5 W</span><span>36\u00b0</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">ADJUSTABLE SPOT</span>\n        <span class=\"small\" style=\"color: #1A1918\">Tilts on its stem to aim at displays, tables and details.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>5 W \u00b7 10 W</span><span>36\u00b0</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">ELVA 5 ZOOM</span>\n        <span class=\"small\" style=\"color: #1A1918\">A beam that adjusts from 15\u00b0 to 55\u00b0 by hand.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>5 W</span><span>15\u201355\u00b0 \u00b7 adjustable</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">GLOBE</span>\n        <span class=\"small\" style=\"color: #1A1918\">A 100 mm sphere of real marble, lit from within.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>5 W</span><span>360\u00b0 \u00b7 marble</span></div>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n        <span class=\"cap\" style=\"color: #6B6660\">On the track</span>\n        <span class=\"h2\">SOUND</span>\n        <span class=\"small\" style=\"color: #1A1918\">Sound sits on the same line as the light.</span>\n        <div style=\"margin-top: auto; display: flex; gap: 20px; font-size: 14px; color: #6B6660\"><span>10 W</span><span>Bluetooth audio</span></div>\n      </div>\n      </div>\n    </div>\n  </section>\n  <section class=\"wrap\" style=\"padding-top: 88px; padding-bottom: 104px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px\">\n    <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A8421F; padding-top: 20px\"><span class=\"cap\" style=\"color: #6B6660\">Finish</span><span style=\"font-size: 20px\">Black or white</span><span class=\"small\">The globe is real marble.</span></div>\n    <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A8421F; padding-top: 20px\"><span class=\"cap\" style=\"color: #6B6660\">Control</span><span style=\"font-size: 20px\">On/off \u00b7 Bluetooth \u00b7 DALI DT8</span><span class=\"small\">Fixed or tunable white.</span></div>\n    <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A8421F; padding-top: 20px\"><span class=\"cap\" style=\"color: #6B6660\">Driver</span><span style=\"font-size: 20px\">VEGA 48 V</span><span class=\"small\">100 W and 200 W, made for the ELVA 5 track. <a href=\"/architectural/drivers/\">LED drivers \u2192</a></span></div>\n  </section>\n  <footer style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #F6F4F0; text-decoration: none\">Architectural</a>\n        <a href=\"/quiklit/\" style=\"color: #F6F4F0; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #F6F4F0; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"/about/\" style=\"color: #F6F4F0; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #F6F4F0; text-decoration: none\">Downloads</a>\n        <a href=\"/contact/\" style=\"color: #F6F4F0; text-decoration: none\">Contact \u00b7 Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #F6F4F0; text-decoration: none\">Instagram \u00b7 @hrisha_lightings</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #F6F4F0; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. \u00a9 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}