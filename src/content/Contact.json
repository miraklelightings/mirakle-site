{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Archivo',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/about/\" style=\"text-decoration: none\">About</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none\">Contact</a>\n      <a class=\"btn\" href=\"/contact/\">Enquire</a>\n    </nav>\n  </header>\n  <div style=\"height: 1px; background: #DCD6CD\"></div>\n  <section class=\"wrap\" style=\"padding-top: 72px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 18px; max-width: 900px\">\n    <span class=\"cap\" style=\"color: #6B6660\">Contact</span>\n    <h1 class=\"disp\">Talk to the right person</h1>\n    <p class=\"body\" style=\"margin: 0\">Each world has its own manager. Write to them directly, or use the form: it goes to the right person automatically. We reply within 24 hours.</p>\n  </section>\n  <section class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3px; padding-bottom: 88px\">\n      <div id=\"architectural\" style=\"display: flex; flex-direction: column; gap: 10px; background: #FFFFFF; padding: 32px\">\n        <div style=\"height: 3px; background: #1A1918; margin: -32px -32px 20px\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">Architectural</span>\n        <span class=\"h2\">Architectural Desk</span>\n        <span class=\"small\">Spotlights, ELVA 5, linear, LED drivers, specification support</span>\n        <a href=\"tel:+919265733457\" style=\"font-size: 20px; text-decoration: none; margin-top: 8px\">+91 92657 33457</a>\n        <a href=\"mailto:roopesh@hrishalightings.com\" class=\"small\" style=\"color: #1A1918\">roopesh@hrishalightings.com</a>\n        <a class=\"btn\" href=\"https://wa.me/919265733457\" style=\"align-self: flex-start; margin-top: 12px\">WhatsApp</a>\n      </div>\n      <div id=\"quiklit\" style=\"display: flex; flex-direction: column; gap: 10px; background: #FFFFFF; padding: 32px\">\n        <div style=\"height: 3px; background: #1A1918; margin: -32px -32px 20px\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">QuikLit</span>\n        <span class=\"h2\">QuikLit Desk</span>\n        <span class=\"small\">Furniture lighting, sample bags, factory supply</span>\n        <a href=\"tel:+919227996634\" style=\"font-size: 20px; text-decoration: none; margin-top: 8px\">+91 92279 96634</a>\n        <a href=\"mailto:quiklit@hrishalightings.com\" class=\"small\" style=\"color: #1A1918\">quiklit@hrishalightings.com</a>\n        <a class=\"btn\" href=\"https://wa.me/919227996634\" style=\"align-self: flex-start; margin-top: 12px\">WhatsApp</a>\n      </div>\n      <div id=\"decorative\" style=\"display: flex; flex-direction: column; gap: 10px; background: #FFFFFF; padding: 32px\">\n        <div style=\"height: 3px; background: #1A1918; margin: -32px -32px 20px\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">Decorative</span>\n        <span class=\"h2\">Decorative Desk</span>\n        <span class=\"small\">Pendants, wall, ceiling, table and floor lights, selections and quotes</span>\n        <a href=\"tel:+919316888316\" style=\"font-size: 20px; text-decoration: none; margin-top: 8px\">+91 93168 88316</a>\n        <a href=\"mailto:luce@hrishalightings.com\" class=\"small\" style=\"color: #1A1918\">luce@hrishalightings.com</a>\n        <a class=\"btn\" href=\"https://wa.me/919316888316\" style=\"align-self: flex-start; margin-top: 12px\">WhatsApp</a>\n      </div>\n  </section>\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 56px\">\n      <div style=\"flex: 1 1 340px; display: flex; flex-direction: column; gap: 14px\">\n        <h2 class=\"h1\">Send an enquiry</h2>\n        <p class=\"body\" style=\"margin: 0\">Choose the world and we route it. Every enquiry gets a reference number by email.</p>\n        <div style=\"margin-top: 24px; display: flex; flex-direction: column; gap: 8px\"><span class=\"cap\" style=\"color: #6B6660\">Showroom</span><span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal, Opp. Rajpath Club, Bodakdev, Ahmedabad 380054</span><span class=\"small\">Open 10:30 am \u2013 7:30 pm</span><a class=\"cap\" href=\"https://maps.google.com/?q=Maruti+Crystal+Bodakdev+Ahmedabad\" style=\"text-decoration: none; margin-top: 8px\">Open in Maps \u2192</a></div>\n      </div>\n      <form aria-label=\"Enquiry\" style=\"flex: 1 1 520px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px\">\n        <label class=\"fld\" style=\"grid-column: 1 / -1\">About<select><option>Architectural</option><option>QuikLit furniture lighting</option><option>Decorative lighting</option><option>Becoming a dealer</option></select></label>\n        <label class=\"fld\">Your name<input type=\"text\"></label>\n        <label class=\"fld\">Mobile<input type=\"tel\"></label>\n        <label class=\"fld\">Company or practice<input type=\"text\"></label>\n        <label class=\"fld\">City<input type=\"text\"></label>\n        <label class=\"fld\" style=\"grid-column: 1 / -1\">Message<textarea rows=\"4\"></textarea></label>\n        <button type=\"button\" class=\"btn\" style=\"grid-column: 1 / -1\">Send</button>\n      </form>\n    </div>\n  </section>\n  <section id=\"dealer\" class=\"wrap\" style=\"padding-top: 88px; padding-bottom: 104px; display: flex; flex-wrap: wrap; gap: 56px\">\n    <div style=\"flex: 1 1 340px; display: flex; flex-direction: column; gap: 14px\"><span class=\"cap\" style=\"color: #6B6660\">Partners</span><h2 class=\"h1\">Become a dealer</h2><p class=\"body\" style=\"margin: 0\">For lighting showrooms, electrical distributors and furniture hardware dealers.</p></div>\n    <form aria-label=\"Dealer enquiry\" style=\"flex: 1 1 520px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px\">\n      <label class=\"fld\">Business name<input type=\"text\"></label>\n      <label class=\"fld\">City and state<input type=\"text\"></label>\n      <label class=\"fld\">Your name<input type=\"text\"></label>\n      <label class=\"fld\">Mobile<input type=\"tel\"></label>\n      <fieldset style=\"grid-column: 1 / -1; border: 0; padding: 0; margin: 0; display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px\"><legend style=\"font-size: 14px; padding: 0 0 8px\">Interested in</legend><label style=\"display: flex; gap: 8px; align-items: center\"><input type=\"checkbox\"> Architectural</label><label style=\"display: flex; gap: 8px; align-items: center\"><input type=\"checkbox\"> QuikLit</label><label style=\"display: flex; gap: 8px; align-items: center\"><input type=\"checkbox\"> Decorative</label></fieldset>\n      <button type=\"button\" class=\"btn\" style=\"grid-column: 1 / -1\">Send dealer enquiry</button>\n    </form>\n  </section>\n  <footer style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #F6F4F0; text-decoration: none\">Architectural</a>\n        <a href=\"/quiklit/\" style=\"color: #F6F4F0; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #F6F4F0; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"/about/\" style=\"color: #F6F4F0; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #F6F4F0; text-decoration: none\">Downloads</a>\n        <a href=\"/contact/\" style=\"color: #F6F4F0; text-decoration: none\">Contact \u00b7 Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #F6F4F0; text-decoration: none\">Instagram \u00b7 @hrisha_lightings</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #F6F4F0; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. \u00a9 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}