{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/about/\" style=\"text-decoration: none\">About</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none\">Contact</a>\n      <a class=\"btn\" href=\"/contact/\">Enquire</a>\n    </nav>\n  </header>\n  <div style=\"height: 1px; background: #DCD6CD\"></div>\n  <section class=\"wrap\" style=\"padding-top: 72px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 18px; max-width: 920px\">\n    <span class=\"cap\" style=\"color: #6B6660\">Downloads</span>\n    <h1 class=\"disp\">Catalogues and datasheets</h1>\n    <p class=\"body\" style=\"margin: 0\">Choose the files you need and tell us who you are. The right MIRAKLE team sends them to your email or WhatsApp, usually within one working day.</p>\n  </section>\n  <section class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3px; padding-bottom: 88px\">\n    \n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A8421F\">\n        <span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical</span><span class=\"h2\">Technical Catalogue 2027\u201328</span><span class=\"small\">ELVA 5 \u00b7 COB \u00b7 Linear \u00b7 LED drivers</span>\n        <button type=\"button\" aria-pressed=\"false\" class=\"btn\" style=\"align-self: flex-start; margin-top: 16px; background: transparent; color: #1A1918; border: 1px solid #1A1918\">Add to request</button>\n      </div>\n    \n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A855F7\">\n        <span class=\"cap\" style=\"color: #6B6660\">QuikLit</span><span class=\"h2\">QuikLit Furniture Lighting Collection 2027\u201328</span><span class=\"small\">Profiles \u00b7 QuikMag \u00b7 sensors \u00b7 power</span>\n        <button type=\"button\" aria-pressed=\"false\" class=\"btn\" style=\"align-self: flex-start; margin-top: 16px; background: transparent; color: #1A1918; border: 1px solid #1A1918\">Add to request</button>\n      </div>\n    \n      <div style=\"background: #FFFFFF; padding: 36px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #B08A4E\">\n        <span class=\"cap\" style=\"color: #6B6660\">Decorative</span><span class=\"h2\">Decorative Collection</span><span class=\"small\">Pendant \u00b7 wall \u00b7 ceiling \u00b7 table \u00b7 floor</span>\n        <button type=\"button\" aria-pressed=\"false\" class=\"btn\" style=\"align-self: flex-start; margin-top: 16px; background: transparent; color: #1A1918; border: 1px solid #1A1918\">Add to request</button>\n      </div>\n    \n  </section>\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 56px\">\n        <div style=\"display: flex; flex-direction: column\"><h2 class=\"h1\" style=\"margin-bottom: 20px\">COB spotlights</h2>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">TITAN datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">SPY datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">ORBIS datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">UNO datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">NANO datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; font: inherit; color: #1A1918; cursor: pointer; text-align: left\"><span style=\"display: flex; flex-direction: column; gap: 4px; text-align: left\"><span style=\"font-size: 16px\">HYDRO datasheet</span><span style=\"font-size: 14px; color: #6B6660\">COB spotlight</span></span><span class=\"cap\" style=\"white-space: nowrap\">Add to request</span></button>\n          \n            <button type=\"button\" aria-pressed=\"false\" style=\"display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid #DCD6CD; background: transparent; fo