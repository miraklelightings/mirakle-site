{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.img{display:block;width:100%;height:100%;object-fit:cover;transition:transform 1.2s ease}\n.panel{transition:flex-grow .6s ease}\n.panel:hover{flex-grow:1.35}\n.panel:hover .img{transform:scale(1.03)}\n@media (max-width:760px){.wrap{padding:0 20px}}\n@media (prefers-reduced-motion:reduce){.panel,.img{transition:none}}\n", "body": "\n\n\n\n\n\n<div style=\"color: #1A1918; background: #F6F4F0\">\n\n  <div style=\"background: #1A1918; color: #E7E3DC\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" style=\"text-decoration: none; padding: 12px 0; color: #E7E3DC; font-size: 12px\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; color: #E7E3DC; font-size: 12px\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; color: #E7E3DC; font-size: 12px\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"#contact\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94; font-size: 12px\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; padding-bottom: 24px\">\n    <a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a>\n    <nav aria-label=\"Main\" style=\"display: flex; gap: 36px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/about/\" style=\"text-decoration: none\">About</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none\">Contact</a>\n      <a class=\"cap\" href=\"#contact\" style=\"text-decoration: none; background: #1A1918; color: #F6F4F0; padding: 13px 22px\">Enquire</a>\n    </nav>\n  </header>\n\n  <section aria-label=\"Three worlds of MIRAKLE\" style=\"display: flex; flex-wrap: wrap; gap: 3px; padding: 0 3px; min-height: 0\">\n    <a class=\"panel\" href=\"/architectural/\" style=\"flex: 1 1 360px; min-width: 0; min-height: 0; text-decoration: none; display: flex; flex-direction: column; background: #F6F4F0; overflow: hidden\">\n      <div style=\"height: 520px; overflow: hidden; background: #DEDBD6\"><img class=\"img\" src=\"/img/titan.jpg\" alt=\"TITAN recessed spotlight, honeycomb micro-lens inside a black reflector\" style=\"object-position: 40% 50%\"></div>\n      <div style=\"height: 3px; background: #A8421F\"></div>\n      <div style=\"padding: 32px 36px 36px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">01 &nbsp;Architectural &amp; Technical</span>\n        <span style=\"font-size: 40px; line-height: 1.1; text-transform: uppercase; color: #1A1918; font-weight: 300; letter-spacing: 0.03em\">Light for architecture</span>\n        <span style=\"font-size: 16px; color: #6B6660; line-height: 1.5\">Spotlights, magnetic track, linear and LED drivers, specified with declared data.</span>\n      </div>\n    </a>\n    <a class=\"panel\" href=\"/quiklit/\" style=\"flex: 1 1 360px; min-width: 0; min-height: 0; text-decoration: none; display: flex; flex-direction: column; background: #F6F4F0; overflow: hidden\">\n      <div style=\"height: 520px; overflow: hidden; background: #DEDBD6\"><img class=\"img\" src=\"/img/qcover.jpg\" alt=\"A QuikLit profile glowing along a dark cabinet edge\" style=\"object-position: 50% 50%\"></div>\n      <div style=\"height: 3px; background: linear-gradient(90deg, #F43F5E, #A855F7)\"></div>\n      <div style=\"padding: 32px 36px 36px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">02 &nbsp;QuikLit</span>\n        <span style=\"font-size: 40px; line-height: 1.1; text-transform: uppercase; color: #1A1918; font-weight: 300; letter-spacing: 0.03em\">Light for furniture</span>\n        <span style=\"font-size: 16px; color: #6B6660; line-height: 1.5\">Solder-free 24V profiles, magnetic lights, sensors and power for modular furniture.</span>\n      </div>\n    </a>\n    <a class=\"panel\" href=\"/decorative/\" style=\"flex: 1 1 360px; min-width: 0; min-height: 0; text-decoration: none; display: flex; flex-direction: column; background: #F6F4F0; overflow: hidden\">\n      <div style=\"height: 520px; overflow: hidden; background: #DEDBD6\"><img class=\"img\" src=\"/img/deco_kitchen.jpg\" alt=\"Brass pendants over a dark timber kitchen island\" style=\"object-position: 55% 30%\"></div>\n      <div style=\"height: 3px; background: #7A5C30\"></div>\n      <div style=\"padding: 32px 36px 36px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">03 &nbsp;Decorative</span>\n        <span style=\"font-size: 40px; line-height: 1.1; text-transform: uppercase; color: #1A1918; font-weight: 300; letter-spacing: 0.03em\">Light for living</span>\n        <span style=\"font-size: 16px; color: #6B6660; line-height: 1.5\">Pendant, wall, ceiling, table and floor lights for homes, hotels and restaurants.</span>\n      </div>\n    </a>\n  </section>\n\n  <section id=\"about\" style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 64px; padding-top: 120px; padding-bottom: 120px\">\n      <div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 28px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; opacity: 0.9\">\n        <h1 style=\"margin: 0; font-size: 40px; line-height: 1.15; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">India's most trusted name in light \u2014 for architects, furniture makers and the homes they create.</h1>\n        <p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #A39D94; max-width: 560px\">Three worlds, one maker: specification lighting for architecture, a solder-free system for modular furniture, and decorative pieces for the rooms in between.</p>\n      </div>\n      <div style=\"flex: 1 1 420px; max-width: 520px; aspect-ratio: 1 / 1; overflow: hidden\"><img class=\"img\" src=\"/img/glow.jpg\" alt=\"A warm circle of light on a dark ceiling\"></div>\n    </div>\n  </section>\n\n  <section class=\"wrap\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); border-bottom: 1px solid #DCD6CD\">\n    <div style=\"padding: 56px 40px 56px 0; display: flex; flex-direction: column; gap: 12px\">\n      <span class=\"cap\" style=\"color: #6B6660\">Made to order</span>\n      <span style=\"font-size: 56px; line-height: 1; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">2\u20133 days</span>\n      <span style=\"font-size: 16px; color: #6B6660; line-height: 1.6\">COB spotlights are configured for each project and typically dispatched in 2\u20133 working days, with no minimum order.</span>\n    </div>\n    <div style=\"padding: 56px 40px; border-left: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 12px\">\n      <span class=\"cap\" style=\"color: #6B6660\">Warranty</span>\n      <span style=\"font-size: 56px; line-height: 1; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">5 years</span>\n      <span style=\"font-size: 16px; color: #6B6660; line-height: 1.6\">On indoor lighting. 2 years on outdoor. Accessories excluded.</span>\n    </div>\n    <div style=\"padding: 56px 40px; border-left: 1px solid #DCD6CD; display: flex; flex-direction: column; gap: 12px\">\n      <span class=\"cap\" style=\"color: #6B6660\">Honest data</span>\n      <span style=\"font-size: 56px; line-height: 1; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">\u00b110%</span>\n      <span style=\"font-size: 16px; color: #6B6660; line-height: 1.6\">Every figure is a declared value. Where we do not have a value, we leave it out.</span>\n    </div>\n  </section>\n\n  <section class=\"wrap\" style=\"padding-top: 128px; padding-bottom: 128px; display: flex; flex-direction: column; gap: 48px\">\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px\">\n      <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">New this season</h2>\n      <span style=\"font-size: 14px; color: #6B6660\">One story from each world</span>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 36px\">\n      <a href=\"/architectural/titan/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 18px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"img\" src=\"/img/orbis.jpg\" alt=\"ORBIS trimless recessed spotlight in white\" style=\"object-position: 35% 50%\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">Architectural \u00b7 COB</span>\n        <span style=\"font-size: 20px; font-weight: 400; line-height: 1.4\">ORBIS. Opens from the front for service. \u00d850 and up.</span>\n      </a>\n      <a href=\"/quiklit/1707/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 18px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"img\" src=\"/img/qmag2.jpg\" alt=\"QuikMag spots on a magnetic track under a wardrobe shelf\" style=\"object-position: 40% 50%\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">QuikLit \u00b7 QuikMag</span>\n        <span style=\"font-size: 20px; font-weight: 400; line-height: 1.4\">QuikMag. Spots and grills that click on anywhere along the track.</span>\n      </a>\n      <a href=\"/decorative/marble/\" style=\"text-decoration: none; display: flex; flex-direction: column; gap: 18px\">\n        <div style=\"aspect-ratio: 4 / 5; overflow: hidden; background: #E3DED6\"><img class=\"img\" src=\"/img/deco_linear.jpg\" alt=\"Linear pendant bars with stone blocks, suspended at different heights\" style=\"object-position: 30% 50%\"></div>\n        <span class=\"cap\" style=\"color: #6B6660\">Decorative \u00b7 Pendant</span>\n        <span style=\"font-size: 20px; font-weight: 400; line-height: 1.4\">Lines of light, hung at different heights over a long table.</span>\n      </a>\n    </div>\n  </section>\n\n  <section style=\"display: flex; flex-wrap: wrap; gap: 3px; padding: 0 3px\">\n    <div style=\"flex: 2 1 560px; height: 560px; overflow: hidden\"><img class=\"img\" src=\"/img/deco_dining.jpg\" alt=\"A silk pendant over a dining table beside a fireplace\"></div>\n    <div style=\"flex: 1 1 320px; min-height: 560px; background: #1A1918; color: #F6F4F0; padding: 56px 48px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; gap: 18px\">\n      <div style=\"height: 3px; width: 64px; background: #B08A4E\"></div>\n      <span class=\"cap\" style=\"color: #A39D94\">Decorative</span>\n      <span style=\"font-size: 40px; line-height: 1.15; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Silk, marble, brass and glass.</span>\n      <span style=\"font-size: 16px; color: #A39D94; line-height: 1.6\">214+ curated designer lights for homes, hotels and restaurants.</span>\n      <a href=\"/decorative/\" class=\"cap\" style=\"color: #F6F4F0; text-decoration: none; margin-top: 8px\">Explore Decorative \u2192</a>\n    </div>\n  </section>\n\n  <section style=\"display: flex; flex-wrap: wrap-reverse; gap: 3px; padding: 3px 3px 0\">\n    <div style=\"flex: 1 1 320px; min-height: 560px; background: #1A1918; color: #F6F4F0; padding: 56px 48px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; gap: 18px\">\n      <div style=\"height: 3px; width: 64px; background: linear-gradient(90deg, #F43F5E, #A855F7)\"></div>\n      <span class=\"cap\" style=\"color: #A39D94\">QuikLit</span>\n      <span style=\"font-size: 40px; line-height: 1.15; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Made for modular furniture.</span>\n      <span style=\"font-size: 16px; color: #A39D94; line-height: 1.6\">Profiles, magnetic lights, sensors and 24V power from one source. No soldering on the factory floor.</span>\n      <a href=\"/quiklit/\" class=\"cap\" style=\"color: #F6F4F0; text-decoration: none; margin-top: 8px\">Explore QuikLit \u2192</a>\n    </div>\n    <div style=\"flex: 2 1 560px; height: 560px; overflow: hidden\"><img class=\"img\" src=\"/img/wardrobe.jpg\" alt=\"A walk-in wardrobe lit shelf by shelf\"></div>\n  </section>\n\n  <section id=\"downloads\" style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 36px\">\n      <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Catalogues</h2>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3px\">\n        <a href=\"/downloads/\" style=\"text-decoration: none; background: #F6F4F0; padding: 36px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n          <span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical</span>\n          <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Technical Catalogue 2027\u201328</span>\n          <span style=\"font-size: 14px; color: #6B6660\">ELVA 5 \u00b7 COB \u00b7 Linear \u00b7 LED drivers</span>\n          <span class=\"cap\" style=\"margin-top: auto\">Request PDF \u2192</span>\n        </a>\n        <a href=\"/downloads/\" style=\"text-decoration: none; background: #F6F4F0; padding: 36px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n          <span class=\"cap\" style=\"color: #6B6660\">QuikLit</span>\n          <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Furniture Lighting Collection 2027\u201328</span>\n          <span style=\"font-size: 14px; color: #6B6660\">Profiles \u00b7 QuikMag \u00b7 sensors \u00b7 power</span>\n          <span class=\"cap\" style=\"margin-top: auto\">Request PDF \u2192</span>\n        </a>\n        <a href=\"/downloads/\" style=\"text-decoration: none; background: #F6F4F0; padding: 36px; display: flex; flex-direction: column; gap: 10px; min-height: 220px\">\n          <span class=\"cap\" style=\"color: #6B6660\">Decorative</span>\n          <span style=\"font-size: 28px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Decorative Collection</span>\n          <span style=\"font-size: 14px; color: #6B6660\">Pendant \u00b7 wall \u00b7 ceiling \u00b7 table \u00b7 floor</span>\n          <span class=\"cap\" style=\"margin-top: auto\">Request PDF \u2192</span>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"contact\" class=\"wrap\" style=\"padding-top: 112px; padding-bottom: 112px; display: flex; flex-direction: column; gap: 44px\">\n    <h2 style=\"margin: 0; font-size: 40px; text-transform: uppercase; font-weight: 300; letter-spacing: 0.03em\">Talk to the right person</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A8421F; padding-top: 24px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Architectural &amp; Technical</span>\n        <span style=\"font-size: 20px\">Roopesh Tripathi</span>\n        <span style=\"font-size: 14px; color: #6B6660\">+91 92657 33457 \u00b7 roopesh@hrishalightings.com</span>\n        <a href=\"https://wa.me/919265733457\" class=\"cap\" style=\"margin-top: 8px; text-decoration: none\">WhatsApp \u2192</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #A855F7; padding-top: 24px\">\n        <span class=\"cap\" style=\"color: #6B6660\">QuikLit</span>\n        <span style=\"font-size: 20px\">Awadhesh Pal</span>\n        <span style=\"font-size: 14px; color: #6B6660\">+91 92279 96634 \u00b7 quiklit@hrishalightings.com</span>\n        <a href=\"https://wa.me/919227996634\" class=\"cap\" style=\"margin-top: 8px; text-decoration: none\">WhatsApp \u2192</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #7A5C30; padding-top: 24px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Decorative</span>\n        <span style=\"font-size: 20px\">Preksha Shah</span>\n        <span style=\"font-size: 14px; color: #6B6660\">+91 93168 88316 \u00b7 luce@hrishalightings.com</span>\n        <a href=\"https://wa.me/919316888316\" class=\"cap\" style=\"margin-top: 8px; text-decoration: none\">WhatsApp \u2192</a>\n      </div>\n    </div>\n  </section>\n\n  <footer style=\"background: #1A1918; color: #E7E3DC\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #E7E3DC; text-decoration: none\">Architectural</a>\n        <a href=\"/quiklit/\" style=\"color: #E7E3DC; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #E7E3DC; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"#about\" style=\"color: #E7E3DC; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #E7E3DC; text-decoration: none\">Downloads</a>\n        <a href=\"#contact\" style=\"color: #E7E3DC; text-decoration: none\">Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #E7E3DC; text-decoration: none\">Instagram \u00b7 @hrisha_lightings</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #E7E3DC; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. \u00a9 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}