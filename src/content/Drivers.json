{"css": "\nbody{margin:0;background:#F6F4F0;font-family:'Archivo',system-ui,sans-serif;color:#1A1918}\na{color:#1A1918}a:hover{color:#6B6660}\n.cap{font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase}\n.wrap{max-width:1440px;margin:0 auto;padding:0 64px;box-sizing:border-box}\n.ph{display:block;width:100%;height:100%;object-fit:cover}\n.h1{margin:0;font-size:40px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.disp{margin:0;font-size:56px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.05}\n.h2{font-size:28px;font-weight:300;text-transform:uppercase;letter-spacing:0.03em;line-height:1.15}\n.body{font-size:16px;line-height:1.65;color:#6B6660}\n.small{font-size:14px;line-height:1.55;color:#6B6660}\n.tbl{width:100%;border-collapse:collapse;font-size:16px}\n.tbl th,.tbl td{text-align:left;padding:14px 16px 14px 0;border-bottom:1px solid #DCD6CD;vertical-align:top}\n.tbl th{font-weight:400;color:#6B6660}\n.fld{display:flex;flex-direction:column;gap:6px;font-size:14px}\n.fld input,.fld select,.fld textarea{padding:14px;border:1px solid #DCD6CD;background:#FFFFFF;font:inherit;color:#1A1918}\n.btn{display:inline-block;background:#1A1918;color:#F6F4F0;border:0;padding:16px 22px;font:inherit;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;text-decoration:none;cursor:pointer}\n@media (max-width:760px){.wrap{padding:0 20px}.disp{font-size:40px}.h1{font-size:28px}}\n", "body": "\n\n\n\n\n\n<div style=\"min-height: 100vh\">\n  <div style=\"background: #1A1918\">\n    <div class=\"wrap\" style=\"display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center; justify-content: space-between; min-height: 40px\">\n      <nav aria-label=\"MIRAKLE worlds\" style=\"display: flex; gap: 28px; flex-wrap: wrap\">\n        <a class=\"cap\" href=\"/architectural/\" aria-current=\"page\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; border-bottom: 2px solid #1A1918; color: #F6F4F0\">Architectural</a>\n        <a class=\"cap\" href=\"/quiklit/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">QuikLit</a>\n        <a class=\"cap\" href=\"/decorative/\" style=\"text-decoration: none; padding: 12px 0; font-size: 12px; color: #A39D94\">Decorative</a>\n      </nav>\n      <a class=\"cap\" href=\"/contact/\" style=\"text-decoration: none; padding: 12px 0; color: #A39D94\">Showroom \u00b7 Bodakdev, Ahmedabad</a>\n    </div>\n  </div>\n  <header class=\"wrap\" style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 22px; padding-bottom: 22px\">\n    <div style=\"display: flex; align-items: center; gap: 16px\"><a href=\"/\" aria-label=\"MIRAKLE home\" style=\"display: flex\"><img src=\"/img/Mirakle_Logo_Black.svg\" alt=\"MIRAKLE\" style=\"height: 30px; width: auto; display: block\"></a><span class=\"cap\" style=\"color: #6B6660\">Architectural</span></div>\n    <nav aria-label=\"Section\" style=\"display: flex; gap: 28px; flex-wrap: wrap; align-items: center\">\n      <a class=\"cap\" href=\"/architectural/elva-5/\" style=\"text-decoration: none\">Magnetic track</a>\n      <a class=\"cap\" href=\"/architectural/#spotlights\" style=\"text-decoration: none\">Spotlights</a>\n      <a class=\"cap\" href=\"/architectural/linear/\" style=\"text-decoration: none\">Linear</a>\n      <a class=\"cap\" href=\"/architectural/drivers/\" style=\"text-decoration: none\">LED drivers</a>\n      <a class=\"cap\" href=\"/downloads/\" style=\"text-decoration: none\">Downloads</a>\n      <a class=\"btn\" href=\"/contact/#architectural\">Spec support</a>\n    </nav>\n  </header>\n  <div style=\"height: 3px; background: #1A1918\"></div>\n  <div class=\"wrap\" style=\"padding-top: 24px; font-size: 14px; color: #6B6660\"><a href=\"/architectural/\" style=\"color: #6B6660\">Architectural</a> / LED drivers</div>\n  <section class=\"wrap\" style=\"padding-top: 40px; padding-bottom: 72px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-end\">\n    <div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 22px\">\n      <span class=\"cap\" style=\"color: #6B6660\">04 \u00b7 LED drivers</span>\n      <h1 class=\"disp\">The power behind the line</h1>\n      <p class=\"body\" style=\"margin: 0; max-width: 560px\">Six families of constant-voltage LED drivers, each matched to a MIRAKLE light and the place it has to live. Choose the light, then the place; the driver follows.</p>\n    </div>\n    <div style=\"flex: 1 1 360px; background: #1A1918; color: #F6F4F0; padding: 40px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px\">\n      <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 40px; font-weight: 300\">19</span><span style=\"font-size: 14px; color: #A39D94\">Drivers in six families</span></div>\n      <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 40px; font-weight: 300\">100%</span><span style=\"font-size: 14px; color: #A39D94\">Of rated load</span></div>\n      <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 40px; font-weight: 300\">24\u2013350 W</span><span style=\"font-size: 14px; color: #A39D94\">24 V and 48 V</span></div>\n      <div style=\"display: flex; flex-direction: column; gap: 4px\"><span style=\"font-size: 40px; font-weight: 300\">5 \u00b7 2 yrs</span><span style=\"font-size: 14px; color: #A39D94\">Warranty, indoor \u00b7 IP67</span></div>\n    </div>\n  </section>\n  <section style=\"background: #EDE9E3\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 104px; display: flex; flex-direction: column; gap: 32px\">\n      <div style=\"display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px\"><h2 class=\"h1\">Choose by where it lives</h2><span class=\"small\">Every MIRAKLE driver carries 100% of its rated load</span></div>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 3px\">\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Inside furniture</span>\n        <span class=\"h2\">EOS</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">Made for furniture. 13 mm high: fits behind a shelf edge or under a wardrobe top.</span>\n        <span class=\"small\">24 V \u00b7 indoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">EOS24</td><td>24 W</td><td style=\"color: #6B6660\">83 \u00d7 33.8 \u00d7 13</td></tr><tr><td style=\"font-weight: 500\">EOS48</td><td>48 W</td><td style=\"color: #6B6660\">93 \u00d7 33.8 \u00d7 13</td></tr><tr><td style=\"font-weight: 500\">EOS100</td><td>100 W</td><td style=\"color: #6B6660\">124 \u00d7 33.8 \u00d7 13</td></tr></tbody></table>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Coves and profiles</span>\n        <span class=\"h2\">ORION</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">Slim enough for the cove. A long, narrow body that lies inside the cove or along the profile.</span>\n        <span class=\"small\">24 V \u00b7 indoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">ORION80</td><td>80 W</td><td style=\"color: #6B6660\">230 \u00d7 19.5 \u00d7 20</td></tr><tr><td style=\"font-weight: 500\">ORION120</td><td>120 W</td><td style=\"color: #6B6660\">230 \u00d7 26 \u00d7 22.5</td></tr><tr><td style=\"font-weight: 500\">ORION160</td><td>160 W</td><td style=\"color: #6B6660\">250 \u00d7 26 \u00d7 22.5</td></tr><tr><td style=\"font-weight: 500\">ORION250</td><td>250 W</td><td style=\"color: #6B6660\">279 \u00d7 26 \u00d7 22.5</td></tr></tbody></table>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Ceilings and general use</span>\n        <span class=\"h2\">HELIOS</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">The everyday driver. Four compact sizes with slow start and a dip-switch output setting.</span>\n        <span class=\"small\">24 V \u00b7 indoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">HELIOS60</td><td>60 W</td><td style=\"color: #6B6660\">152 \u00d7 36 \u00d7 29</td></tr><tr><td style=\"font-weight: 500\">HELIOS100</td><td>100 W</td><td style=\"color: #6B6660\">152 \u00d7 50 \u00d7 29</td></tr><tr><td style=\"font-weight: 500\">HELIOS150</td><td>150 W</td><td style=\"color: #6B6660\">172 \u00d7 50 \u00d7 29</td></tr><tr><td style=\"font-weight: 500\">HELIOS200</td><td>200 W</td><td style=\"color: #6B6660\">188 \u00d7 50 \u00d7 29</td></tr></tbody></table>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Large projects</span>\n        <span class=\"h2\">APOLLO</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">The project driver. Universal 100\u2013277 V input, for long runs on demanding sites.</span>\n        <span class=\"small\">24 V \u00b7 indoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">APOLLO100</td><td>100 W</td><td style=\"color: #6B6660\">172 \u00d7 56 \u00d7 30</td></tr><tr><td style=\"font-weight: 500\">APOLLO200</td><td>200 W</td><td style=\"color: #6B6660\">207 \u00d7 56 \u00d7 30</td></tr><tr><td style=\"font-weight: 500\">APOLLO350</td><td>350 W</td><td style=\"color: #6B6660\">237 \u00d7 62 \u00d7 34</td></tr></tbody></table>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">Outdoors and fa\u00e7ades</span>\n        <span class=\"h2\">ATLAS \u00b7 NEW</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">Built for the outdoors. A sealed IP67 die-cast aluminium body that lives outside with the light.</span>\n        <span class=\"small\">IP67 \u00b7 outdoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">ATLAS60</td><td>60 W</td><td style=\"color: #6B6660\">173 \u00d7 66 \u00d7 40</td></tr><tr><td style=\"font-weight: 500\">ATLAS100</td><td>100 W</td><td style=\"color: #6B6660\">193 \u00d7 66 \u00d7 40</td></tr><tr><td style=\"font-weight: 500\">ATLAS200</td><td>200 W</td><td style=\"color: #6B6660\">203 \u00d7 66 \u00d7 40</td></tr></tbody></table>\n      </div>\n      <div style=\"background: #FFFFFF; padding: 32px; display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #6B6660\">48 V track and indoor strips</span>\n        <span class=\"h2\">VEGA \u00b7 NEW</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">48 V for track and strip: the driver for the ELVA 5 magnetic track and indoor 48 V LED strips.</span>\n        <span class=\"small\">48 V \u00b7 indoor</span>\n        <table class=\"tbl\" style=\"font-size: 14px; margin-top: 8px\"><thead><tr><th scope=\"col\">Model</th><th scope=\"col\">Power</th><th scope=\"col\">L \u00d7 W \u00d7 H, mm</th></tr></thead><tbody><tr><td style=\"font-weight: 500\">VEGA100</td><td>100 W</td><td style=\"color: #6B6660\">138 \u00d7 50 \u00d7 24</td></tr><tr><td style=\"font-weight: 500\">VEGA200</td><td>200 W</td><td style=\"color: #6B6660\">180 \u00d7 42 \u00d7 25</td></tr></tbody></table>\n      </div>\n      </div>\n    </div>\n  </section>\n  <footer style=\"background: #1A1918; color: #F6F4F0\">\n    <div class=\"wrap\" style=\"padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px\">\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <img src=\"/img/Mirakle_Logo_White.svg\" alt=\"MIRAKLE\" style=\"height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Showroom</span>\n        <span style=\"font-size: 16px; line-height: 1.6\">101\u2013103 Maruti Crystal, Nr. Gordhan Thal,<br>Opp. Rajpath Club, Bodakdev,<br>Ahmedabad 380054</span>\n        <span style=\"font-size: 14px; color: #A39D94\">Open 10:30 am \u2013 7:30 pm</span>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Worlds</span>\n        <a href=\"/architectural/\" style=\"color: #F6F4F0; text-decoration: none\">Architectural</a>\n        <a href=\"/quiklit/\" style=\"color: #F6F4F0; text-decoration: none\">QuikLit</a>\n        <a href=\"/decorative/\" style=\"color: #F6F4F0; text-decoration: none\">Decorative</a>\n      </div>\n      <div style=\"display: flex; flex-direction: column; gap: 12px\">\n        <span class=\"cap\" style=\"color: #A39D94\">Company</span>\n        <a href=\"/about/\" style=\"color: #F6F4F0; text-decoration: none\">About MIRAKLE</a>\n        <a href=\"/downloads/\" style=\"color: #F6F4F0; text-decoration: none\">Downloads</a>\n        <a href=\"/contact/\" style=\"color: #F6F4F0; text-decoration: none\">Contact \u00b7 Become a dealer</a>\n        <a href=\"https://www.instagram.com/hrisha_lightings\" style=\"color: #F6F4F0; text-decoration: none\">Instagram \u00b7 @hrisha_lightings</a>\n        <a href=\"https://www.witlamps.com\" style=\"color: #F6F4F0; text-decoration: none\">WIT Lamps</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-bottom: 40px; font-size: 12px; color: #A39D94; line-height: 1.6\">MIRAKLE is a brand of Hrisha Lighting Projects LLP, Ahmedabad 380054. \u00a9 2026. Room scenes are visualisations.</div>\n  </footer>\n</div>\n", "footer": false}